# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database (matches docker-compose.yml) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=ggi
DB_PASSWORD=ggi_password
DB_NAME=ggi_assessment
DB_LOGGING=false

# ---- Free tier ----
# Messages every user gets for free, reset on the 1st of each month.
FREE_MESSAGES_PER_MONTH=3

# ---- Mocked OpenAI provider ----
# Simulated API latency window (ms). A random delay in this range is applied
# to every completion so the service behaves like a real network call.
MOCK_AI_MIN_DELAY_MS=300
MOCK_AI_MAX_DELAY_MS=1200
MOCK_AI_MODEL=gpt-4o-mini

# ---- Billing simulation ----
# Probability (0..1) that a simulated renewal charge fails.
PAYMENT_FAILURE_RATE=0.2

# ---- Scheduled jobs ----
# Set to false to disable cron and drive billing purely via the manual endpoints.
ENABLE_SCHEDULED_JOBS=true
