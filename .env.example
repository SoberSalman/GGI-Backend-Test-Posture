# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database (matches docker-compose.yml) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=ggi
DB_PASSWORD=ggi_password
DB_NAME=ggi_assessment
DB_LOGGING=false
# Concurrent chat requests are bounded by this: each holds a connection for the
# length of its quota transaction.
DB_POOL_SIZE=10

# ---- Free tier ----
# Messages every user gets for free, reset on the 1st of each month.
FREE_MESSAGES_PER_MONTH=3

# ---- Mocked OpenAI provider ----
# Simulated API latency window (ms). A random delay in this range is applied
# to every completion so the service behaves like a real network call.
MOCK_AI_MIN_DELAY_MS=300
MOCK_AI_MAX_DELAY_MS=1200
MOCK_AI_MODEL=gpt-4o-mini
# Hard ceiling on a completion. A hung provider would otherwise hold the
# reserved quota open indefinitely.
AI_TIMEOUT_MS=15000

# ---- Billing simulation ----
# Probability (0..1) that a simulated renewal charge fails.
PAYMENT_FAILURE_RATE=0.2

# ---- Administrative access ----
# Required by POST /billing/run and POST /billing/reset-free-quota, which act on
# every account. Leave unset outside production to keep them open for review;
# they are refused in production when unset.
ADMIN_API_KEY=

# Exposes GET /users, which lists seeded ids for the x-user-id header.
# Defaults to off in production.
EXPOSE_SEED_USERS=true

# ---- Rate limiting ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ---- Scheduled jobs ----
# Set to false to disable cron and drive billing purely via the manual endpoints.
ENABLE_SCHEDULED_JOBS=true
